# Base de développement : PostgreSQL dans Docker, sur ce poste (docker-compose.yml, npm run db:up).
# Identifiants de développement, pas des secrets : à garder tels quels dans .env. En ligne, la base est Neon.
# Adresse utilisée par l'application :
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
# Adresse utilisée par drizzle-kit pour les migrations (la même en local) :
DATABASE_URL_DIRECT=postgresql://postgres:postgres@localhost:5432/app
# Adresse publique du site, sans barre finale (https://www.mon-site.fr), en production.
# Sans elle : le domaine de production fourni par Vercel, sinon http://localhost:3000.
# Chez un autre hébergeur que Vercel, elle est obligatoire.
SITE_URL=
# Chez un autre hébergeur que Vercel seulement, en production : PULSE_ENV=production
# (migrations avant la construction, validation des variables toujours active). Vide en local.
PULSE_ENV=
