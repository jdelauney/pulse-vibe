#!/usr/bin/env bash
# pulse-pile-next – outil du pack de pile Next.js de Pulse (plugin pulse-next).
# Claude Code place le dossier bin/ du plugin dans le PATH. Le cœur Pulse l'appelle :
#   - par pulse-aidd contexte <commande>, quand docs/technical.md déclare « **Pack de pile Pulse** : next » ;
#   - par pulse-aidd pile <sous-commande>, qui relaie les autres sous-commandes.
#
#   pulse-pile-next info                  id, nom, resume, version, couvre (familles de qualité du cœur que le pack remplace)
#   pulse-pile-next contexte <libellé>    consignes du pack : une commande (tech, implement…), une commande et son mode (`deploy-premiere`, `deploy-production`, `deploy-variables`, `fix-en-ligne`, `perf-code`), `piles` (avant le choix de la pile) ou `code` ; un libellé inconnu ne renvoie rien ;
#                                         la mise en ligne (deploy*, fix-en-ligne, cicd, secrets) suit l'hébergement déclaré dans docs/technical.md
#                                         (« **Hébergement** : vercel|docker|serveur » ; vercel sans cette ligne)
#   pulse-pile-next reference <chemin>    affiche une référence du pack (ex. fiche.md)
#   pulse-pile-next recettes              liste les recettes
#   pulse-pile-next recette <nom> [etape <id> | tests]   vue d'ensemble d'une recette (ex. connexion), une de ses étapes, ou le code de ses tests
#   pulse-pile-next squelette [options]   crée le projet de départ (voir pulse-pile-next squelette --aide)
#   pulse-pile-next seo-code [--pages] [--json] [--dossier <projet>]   contrôles du code pour le référencement
#   pulse-pile-next entite <description.json> [--essai] [--us <US-XXX>] [--dossier <projet>]   écrit tout le code d'un type d'information (liste, création, modification, suppression, tests) d'après sa description (format : reference entite.md) ; --essai : la liste des fichiers, sans rien écrire
#   pulse-pile-next police <famille> [--role texte|titres|code] [--graisses 400,600]   pose une police servie par le site (fichiers récupérés sur Bunny Fonts)
#   pulse-pile-next secrets regles|tester <NOM>|suites <NOM>|fiche <NOM>   règles, test réel et variables déduites (valeurs en JSON sur l'entrée standard), fiche d'une variable (pour pulse-aidd secrets)
#   pulse-pile-next hebergeur ls|envoyer <NOM> <env>|redeployer <env>   adaptateur d'hébergeur de pulse-aidd secrets (valeur sur l'entrée standard) :
#                                         Vercel par son CLI ; docker et serveur : la marche à suivre sur le serveur (code 3)
#
# Ne sort jamais en erreur pour "info" et "contexte" : un échec annulerait la commande /pulse.

# Relais PowerShell (bin/<outil>.ps1) : il lance ce script sans argument et passe les siens par l'environnement, tels quels.
# Les relire seulement dans ce cas (sinon les arguments de la ligne de commande comptent), puis toujours les effacer.
if [ $# -eq 0 ] && [ -n "${PULSE_RELAIS_ARGC:-}" ]; then
  _n="$PULSE_RELAIS_ARGC"
  case "$_n" in ''|*[!0-9]*|?????*) _n=0 ;; esac # un nombre de 1 à 4 chiffres, jamais une expression
  _n=$((10#$_n))
  _a=()
  for ((_i = 0; _i < _n; _i++)); do _v="PULSE_RELAIS_ARG_$_i"; _a+=("${!_v}"); done
  if [ "${#_a[@]}" -gt 0 ]; then set -- "${_a[@]}"; fi # un seul set (pas de reconstruction à chaque tour)
  unset _n _i _v _a
fi
unset "${!PULSE_RELAIS_ARG@}" PULSE_RELAIS_ARGC
# Bac à sable de Claude Code (SANDBOX_RUNTIME=1) : le réseau passe par un proxy que fetch de Node lit seulement avec
# NODE_USE_ENV_PROXY=1 ; sans lui, toute requête des scripts échoue, même vers un domaine autorisé (essais du 2026-11-19).
if [ "${SANDBOX_RUNTIME:-}" = 1 ] && [ -n "${HTTPS_PROXY:-}${https_proxy:-}" ]; then export NODE_USE_ENV_PROXY=1; fi

RACINE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REF="$RACINE/references"

afficher() { # afficher <titre> <chemin>
  if [ -f "$2" ]; then
    printf '\n----- %s -----\n\n' "$1"
    cat "$2"
    printf '\n'
  fi
}

# Hébergement du projet, lu dans docs/technical.md du dossier courant : vercel (par défaut), docker ou serveur.
hebergement() {
  local h=""
  if [ -f docs/technical.md ]; then h="$(sed -n 's/^\*\*Hébergement\*\* *: *\([a-z]*\).*$/\1/p' docs/technical.md | head -n 1)"; fi
  case "$h" in docker|serveur) printf '%s' "$h" ;; *) printf 'vercel' ;; esac
}

# Consignes de mise en ligne selon l'hébergement : la première pour Vercel, la seconde pour un serveur (docker ou
# serveur : contexte/hors-vercel/, commun aux deux, puisque scripts/deployer.sh leur donne les mêmes commandes).
selon_hebergement() { # selon_hebergement <chemin Vercel> <chemin serveur>
  if [ "$(hebergement)" = vercel ]; then printf '%s' "$1"; else printf '%s' "$2"; fi
}

# Variables d'environnement chez l'hébergeur : Vercel, ou le fichier .env du serveur.
variables_hebergeur() {
  if [ "$(hebergement)" = vercel ]; then afficher "Variables d'environnement chez Vercel" "$REF/contexte/variables-vercel.md"
  else afficher "Variables d'environnement sur le serveur" "$REF/contexte/hors-vercel/variables.md"; fi
}

version() { sed -n 's/^ *"version": *"\([^"]*\)".*/\1/p' "$RACINE/.claude-plugin/plugin.json" | head -n 1; }

# Une partie de recette, sans les blocs réservés à un autre hébergement (balises « … hebergement: <valeurs> »).
lire_recette() { node "$RACINE/scripts/decouper-recette.js" --hebergement "$(hebergement)" <"$1"; }

recettes() {
  local f nom titre
  for f in "$REF"/recettes/*/index.md; do
    [ -f "$f" ] || continue
    nom="$(basename "$(dirname "$f")")"
    titre="$(sed -n 's/^> Quand l.utiliser : //p' "$f" | head -n 1)"
    printf -- '- %s : %s\n' "$nom" "$titre"
  done
}

etapes_recette() { # etapes_recette <dossier> : liste « - etape <id> : <titre> » des étapes
  sed -n 's/^- Étape \([^ ]*\) – \(.*\) : `pulse-aidd pile recette .*`$/- etape \1 : \2/p' "$1/index.md"
}

liste_recettes() {
  printf '\n----- Recettes disponibles (pulse-aidd pile recette <nom>) -----\n\n'
  recettes
}

contexte() {
  case "$1" in
    piles)
      cat "$REF/contexte/piles.md" ;;
    code)
      afficher "Pour écrire du code" "$REF/contexte/code.md" ;;
    tech)
      afficher "Pour /pulse:tech" "$REF/contexte/tech.md"
      afficher "Valeurs de docs/technical.md" "$REF/technical.md" ;;
    ui)
      afficher "Pour /pulse:ui" "$REF/contexte/ui.md"
      afficher "Pour écrire du code" "$REF/contexte/code.md" ;;
    nouveau)
      afficher "Pour /pulse:nouveau" "$REF/contexte/nouveau.md" ;;
    spec)
      afficher "Pour /pulse:spec" "$REF/contexte/spec.md"
      liste_recettes ;;
    plan)
      afficher "Pour /pulse:plan" "$REF/contexte/plan.md"
      afficher "Architecture du code : où va chaque fichier, sens des imports, modèles" "$REF/architecture.md"
      liste_recettes ;;
    refine)
      afficher "Pour /pulse:plan" "$REF/contexte/plan.md"
      liste_recettes ;;
    implement|fix)
      afficher "Pour réaliser et corriger" "$REF/contexte/implement.md"
      afficher "Fiche de la pile : règles pour un code juste du premier coup" "$REF/fiche.md"
      liste_recettes ;;
    review)
      afficher "Pour relire" "$REF/contexte/review.md"
      afficher "Fiche de la pile : règles pour un code juste du premier coup" "$REF/fiche.md" ;;
    security)
      afficher "Pour relire" "$REF/contexte/review.md"
      afficher "Pour la sécurité" "$REF/contexte/security.md" ;;
    test)
      afficher "Pour les tests" "$REF/contexte/test.md" ;;
    deploy)
      afficher "Pour mettre en ligne" "$(selon_hebergement "$REF/contexte/deploy.md" "$REF/contexte/hors-vercel/deploy.md")" ;;
    deploy-premiere)
      afficher "Pour la première mise en ligne" "$(selon_hebergement "$REF/contexte/deploy-premiere.md" "$REF/contexte/hors-vercel/deploy-premiere.md")" ;;
    deploy-production)
      afficher "Pour le mode production" "$(selon_hebergement "$REF/contexte/deploy-production.md" "$REF/contexte/hors-vercel/deploy-production.md")" ;;
    fix-en-ligne)
      afficher "Pour corriger un problème du site en ligne" "$(selon_hebergement "$REF/contexte/fix-en-ligne.md" "$REF/contexte/hors-vercel/fix-en-ligne.md")" ;;
    deploy-variables)
      variables_hebergeur ;;
    cicd)
      afficher "Pour les contrôles automatiques" "$REF/contexte/cicd.md"
      case "$(hebergement)" in
        docker) afficher "Contrôle propre à l'hébergement docker" "$REF/contexte/docker/cicd.md" ;;
        serveur) afficher "Contrôle propre à l'hébergement serveur" "$REF/contexte/serveur/cicd.md" ;;
      esac ;;
    secrets)
      afficher "Pour /pulse:secrets" "$REF/contexte/secrets.md"
      variables_hebergeur ;;
    seo)
      afficher "Pour /pulse:seo" "$REF/contexte/seo.md"
      afficher "Pour écrire du code" "$REF/contexte/code.md" ;;
    perf)
      afficher "Pour /pulse:perf" "$REF/contexte/perf.md"
      afficher "Pour écrire du code" "$REF/contexte/code.md" ;;
    perf-code)
      afficher "Pour mesurer la vitesse du code" "$REF/contexte/perf-code.md" ;;
    search-console)
      afficher "Pour Search Console" "$REF/contexte/search-console.md" ;;
    rediger)
      afficher "Pour /pulse:rediger" "$REF/contexte/rediger.md"
      afficher "Pour écrire du code" "$REF/contexte/code.md" ;;
    *) ;;
  esac
}

case "$1" in
  info)
    printf 'id: next\nnom: Pulse Next.js\nresume: Next.js 16, Drizzle + Neon, better-auth, next-safe-action, shadcn/ui, Vercel : code de départ vérifié et recettes prêtes.\nversion: %s\ncouvre: organisation\ndomaines: vercel.com *.vercel.com *.vercel.app console.neon.tech *.neon.tech fonts.bunny.net cdn.playwright.dev storage.googleapis.com\n' "$(version)"
    exit 0 ;;
  contexte)
    contexte "$2"; exit 0 ;;
  reference)
    case "$2" in
      ""|*..*) echo "Indiquez un chemin dans references/ du pack, par exemple fiche.md. Disponibles :"; (cd "$REF" && find . -type f | sed 's|^\./||' | sort); exit 1 ;;
    esac
    if [ -f "$REF/$2" ]; then cat "$REF/$2"; else echo "Référence introuvable : $2. Disponibles :"; (cd "$REF" && find . -type f | sed 's|^\./||' | sort); exit 1; fi ;;
  recettes)
    recettes; exit 0 ;;
  recette)
    case "$2" in
      ""|*/*|*..*) echo "Indiquez le nom d'une recette. Disponibles :"; recettes; exit 1 ;;
    esac
    dossier="$REF/recettes/$2"
    if [ ! -f "$dossier/index.md" ]; then echo "Recette introuvable : $2. Disponibles :"; recettes; exit 1; fi
    case "$3" in
      "") lire_recette "$dossier/index.md" ;;
      tests)
        if [ -f "$dossier/tests.md" ]; then lire_recette "$dossier/tests.md"; else echo "La recette $2 n'a pas de tests à copier : ses tests se trouvent dans ses étapes."; exit 1; fi ;;
      etape)
        case "$4" in
          ""|*/*|*..*) echo "Indiquez une étape de la recette $2 :"; etapes_recette "$dossier"; exit 1 ;;
        esac
        if [ -f "$dossier/etape-$4.md" ]; then lire_recette "$dossier/etape-$4.md"; else echo "Étape introuvable : $4. Étapes de la recette $2 :"; etapes_recette "$dossier"; exit 1; fi ;;
      *) echo "Usage : pulse-pile-next recette <nom> [etape <id> | tests]. Étapes de la recette $2 :"; etapes_recette "$dossier"; exit 1 ;;
    esac
    exit 0 ;;
  squelette)
    shift; exec node "$RACINE/scripts/squelette.js" "$@" ;;
  seo-code)
    shift; exec node "$RACINE/scripts/seo-code.js" "$@" ;;
  entite)
    shift; exec node "$RACINE/scripts/entite.js" "$@" ;;
  police)
    shift; exec node "$RACINE/scripts/police.js" "$@" ;;
  secrets)
    shift; exec node "$RACINE/scripts/sondes-secrets.js" "$@" ;;
  hebergeur)
    shift
    if [ "$(hebergement)" = vercel ]; then exec node "$RACINE/scripts/secrets-vercel.js" "$@"; fi
    exec node "$RACINE/scripts/hebergeur-serveur.js" "$(hebergement)" "$@" ;;
  *)
    sed -n '2,/^$/p' "${BASH_SOURCE[0]}" | sed -n 's/^# \{0,1\}//p' ;;
esac
