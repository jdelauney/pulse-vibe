{
  "description": "Pulse – garde-fou anti-secrets (bloque l'écriture d'une clé secrète dans le code et l'envoi de fichiers .env ou de clés dans Git), garde-fou des commandes (refuse l'envoi forcé, le contournement des contrôles et l'indexation globale ; demande confirmation avant une commande qui jette du travail, supprime, écrase une base ou publie en production), synchronisation de la mémoire projet et registre des sessions ouvertes (pour proposer un worktree quand deux sessions travaillent sur le même dossier), et régénération du guide de réalisation à chaque modification d'un plan de aidd_docs/tasks/.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/memoire.js"],
            "timeout": 20
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/sessions.js", "--debut"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/sessions.js", "--fin"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guide.js", "--hook"],
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/garde-secrets.js"],
            "timeout": 20,
            "statusMessage": "Pulse vérifie l'absence de secrets…"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/garde-secrets.js"],
            "timeout": 20,
            "statusMessage": "Pulse vérifie l'absence de secrets…"
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/garde-commandes.js"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
