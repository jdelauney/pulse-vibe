{
  "description": "Pulse – garde-fou anti-secrets (bloque l'écriture d'une clé secrète dans le code, la lecture des fichiers .env et l'envoi de fichiers .env ou de clés dans Git, sous Bash comme sous PowerShell), garde-fou des commandes (refuse l'envoi forcé, le contournement des contrôles, l'indexation globale, la lecture de .env, la suppression du disque ou du projet, la suppression ou la publication d'un dépôt ; demande confirmation avant une commande qui jette du travail, supprime, écrase une base, publie en production ou envoie un secret), synchronisation de la mémoire projet, registre des sessions ouvertes, et régénération du guide de réalisation à chaque modification d'un plan de aidd_docs/tasks/.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/memoire.js"],
            "timeout": 20
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/sessions.js", "--debut"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/sessions.js", "--fin"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guide.js", "--hook"],
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/garde-secrets.js"],
            "timeout": 20,
            "statusMessage": "Pulse vérifie l'absence de secrets…"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/garde-secrets.js"],
            "timeout": 20,
            "statusMessage": "Pulse vérifie l'absence de secrets…"
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/garde-commandes.js"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/garde-secrets.js"],
            "timeout": 20,
            "statusMessage": "Pulse vérifie l'absence de secrets…"
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/garde-commandes.js"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/garde-secrets.js"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
