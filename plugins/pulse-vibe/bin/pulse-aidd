#!/usr/bin/env bash
# pulse-aidd – outil interne du plugin Pulse.
# Claude Code place le dossier bin/ du plugin dans le PATH : les commandes /pulse:*
# l'utilisent pour charger leurs règles et modèles sans demander d'autorisation de lecture.
#
#   pulse-aidd contexte <commande>   affiche les règles et modèles utiles à une commande
#   pulse-aidd etape <commande> [--sans-communes]   idem, précédé des instructions de la commande ; --sans-communes : sans les règles communes ni leurs modules, déjà chargés par la commande qui enchaîne l'étape
#   pulse-aidd etape <commande> --sans-noyau   idem, sans le noyau des règles communes, déjà chargé ; garde les modules de l'étape (tâches, relecture, réalisation)
#   pulse-aidd modele <fichier>      affiche un modèle de templates/, ou d'une skill : <skill>/<fichier> (skills/<skill>/assets/)
#   pulse-aidd agent <nom>           affiche les consignes d'un agent (reviewer, security-auditor, explorer, implementer, verifier, fixer, test-writer, test-runner, designer, ui-critic, redacteur, memory-compactor)
#   pulse-aidd memoire               synchronise la mémoire projet (aidd_docs/memory/) dans CLAUDE.md
#   pulse-aidd qualite <famille…> [--tout] [--checklists]  affiche les familles nommées des règles de qualité du code (clean-code, organisation, composants, securite) ; sans nom : la règle de choix ; --tout : toutes ; --checklists : leurs checklists seules
#   pulse-aidd tests <morceau…> [--tout] [--checklists]  affiche les morceaux nommés de la méthode de tests (strategie, ecrire, unitaire, integration, bout-en-bout, tdd, gherkin) ; sans nom : le sommaire ; --tout : toute ; --checklists : leurs listes de contrôle seules
#   pulse-aidd reference <chemin>    affiche une référence de references/ (ex. qualite/code-concepts.md), ou d'une skill : <skill>/<fichier> (skills/<skill>/references/, ex. seo/regles.md)
#   pulse-aidd nouveau [options]     crée ou prépare un projet Pulse (voir pulse-aidd nouveau --aide)
#   pulse-aidd guide                 régénère le guide de réalisation docs/guide/ à partir des plans de aidd_docs/tasks/
#   pulse-aidd comparer <dossier>    écrit <dossier>/comparer.html pour comparer des variantes (/pulse:ui)
#   pulse-aidd sessions [<session>]  indique si d'autres sessions Claude Code sont ouvertes sur ce dossier
#   pulse-aidd sessions --ici <session>  réinscrit la session sur le dossier courant (entrée ou sortie d'un worktree)
#   pulse-aidd annuler <etat|apercu|defaire|mettre-de-cote|recuperer>  les gestes Git de /pulse:annuler (état, aperçu, défaire une tâche, une US ou une version, mettre de côté, récupérer) ; l'état d'avant est remis si un geste échoue
#   pulse-aidd verifier              contrôle les secrets, les fichiers d'environnement suivis par Git et les scénarios sans test
#   pulse-aidd preuve lancer [--portee suite | --portee tache [<fichiers de test…>]] [--construire]  lance les contrôles automatiques, les tests (toute la suite ou les fichiers donnés) et, avec --construire, la construction ; garde la preuve, liée au contenu des fichiers
#   pulse-aidd preuve construire     ajoute la construction à la preuve à jour, sans relancer contrôles ni tests (code 2 sans preuve à jour : rien n'est lancé)
#   pulse-aidd preuve etat [--exiger suite] [--exiger construction]  la preuve est à jour et verte (code 0), ou rouge, périmée, absente, de portée insuffisante (code 1) ; « Tester » à « aucune » (choix du projet) satisfait --exiger suite
#   pulse-aidd scenarios             état de couverture des scénarios des specs (testés, sans test, manuels)
#   pulse-aidd etat [--sans-git]     état du projet et prochaine étape conseillée (lignes « clé: valeur », pour /pulse:init et /pulse:status)
#   pulse-aidd travail-fini [dossier]  efface le travail en cours (aidd_docs/tasks/in-progress.md) du dossier donné (par défaut le dossier courant ; un worktree : .claude/worktrees/<nom>)
#   pulse-aidd revue <Tn> [<Tn>…]    dernière relecture de chaque tâche et où reprendre (examen, correction, test, commit, aide), pour /pulse:commit, /pulse:implement, /pulse:spirc et /pulse:review ; revue <US-XXX> : la relecture de toute l'US (rythme rapide)
#   pulse-aidd autorisations [--ecrire]  les règles d'autorisation utiles au projet (clés, Git, contrôles de Pulse et du projet) ; --ecrire les ajoute à .claude/settings.json
#   pulse-aidd copies [--mettre-a-jour]  l'état des copies de Pulse dans le projet (contrôle des secrets, ligne d'état) : a-jour, ancienne, adaptee ; --mettre-a-jour remplace les anciennes intactes
#   pulse-aidd ligne-etat [--installer [--remplacer] | --retirer]  la ligne d'état de Claude Code (US, tâche, avancement, décision en attente) ; --installer la règle dans .claude/settings.local.json (/pulse:status ligne)
#   pulse-aidd captures effacer <US-XXX>  retire les captures d'écran gardées comme preuves (aidd_docs/captures/<US-XXX>/), une fois l'US envoyée
#   pulse-aidd bilan                 le bilan chiffré de chaque US (tâches, relectures, corrections, tests non concluants, constats par gravité)
#   pulse-aidd realisation [debut|etape|questions|fin]  le marqueur « réalisation en cours » (aidd_docs/tasks/realisation.json) : debut <US-XXX> --commande <spirc|implement> --rythme <complet|rapide> [--autonome] [--devant] · etape <Tn> <étape> (avec --devant, realisation affiche ensuite la fiche du pack de pile) · questions <n> · fin ; sans action : l'état
#   pulse-aidd attente <mettre-de-cote <Tn> -- <fichier…> | remettre <Tn> | liste>  met de côté le travail d'une tâche qui attend une réponse, le remet en place ensuite, ou liste les tâches en attente (/pulse:spirc, mode autonome)
#   pulse-aidd verifier-spec <US-XXX>  contrôle la spec d'une US avant son verrouillage (critères illustrés, niveaux des scénarios, sections, TBD), pour /pulse:spec
#   pulse-aidd verifier-plan <US-XXX>  contrôle le plan d'une US avant la réalisation (critères, scénarios, dépendances, fichiers, taille), pour /pulse:plan et /pulse:spirc
#   pulse-aidd installer-ci [--forcer]  copie le contrôle des secrets et un exemple de CI à adapter dans le projet (garde un verifier.js adapté, sauf --forcer)
#   pulse-aidd installer-hook        installe le contrôle des secrets avant chaque commit Git (.git/hooks/pre-commit)
#   pulse-aidd piles                 liste les packs de pile installés (plugins qui fournissent pulse-pile-<id>)
#   pulse-aidd pile                  indique le pack de pile déclaré par le projet (docs/technical.md) et s'il est installé
#   pulse-aidd pile <sous-commande>  relaie vers l'outil du pack déclaré (ex. pulse-aidd pile recette connexion)
#   pulse-aidd sonder <adresse> [--texte "…"] [--entetes]  vérifie qu'un site en ligne répond (code 200, texte attendu) ; --entetes : les en-têtes servis
#   pulse-aidd secrets [action]      les secrets du projet, sans jamais afficher une valeur (inventaire, preparer, generer, elaguer, verifier, envoyer, redeployer, historique, journal ; voir pulse-aidd secrets aide)
#   pulse-aidd seo <adresse> [options]   audit de référencement du site servi (options : pulse-aidd seo) ; pulse-aidd seo robots <A|B|C|D> : robots.txt d'une politique IA
#   pulse-aidd perf <action> [options]  mesure la vitesse : mesurer, terrain, comparer, budget, cle, installer (sans action : l'aide)
#   pulse-aidd textes verifier <fichier|-> [--json]   contrôle les tics d'écriture IA d'un texte (/pulse:rediger)
#   pulse-aidd contraste <couleur> <fond> [--viser <rapport>] [--json]   rapport de contraste WCAG exact (hex, rgb, oklch)
#   pulse-aidd identite extraire [dossier] [--json]   relève couleurs, polices et rayons déjà écrits dans le projet (/pulse:ui)
#   pulse-aidd maquettes verifier <fichier|dossier>   contrôle les anti-patterns détectables dans les pages HTML (/pulse:ui)
#   pulse-aidd search-console <action>  Search Console en lecture seule : connecter, deconnecter, proprietes, lire, suivre, inspecter <adresse>
#
# Ne sort jamais en erreur pour "contexte" et "etape" : un échec annulerait la commande /pulse.

# Relais PowerShell (bin/<outil>.ps1) : il lance ce script sans argument et passe les siens par l'environnement, tels quels.
# Les relire seulement dans ce cas (sinon les arguments de la ligne de commande comptent), puis toujours les effacer.
if [ $# -eq 0 ] && [ -n "${PULSE_RELAIS_ARGC:-}" ]; then
  _n="$PULSE_RELAIS_ARGC"
  case "$_n" in ''|*[!0-9]*|?????*) _n=0 ;; esac # un nombre de 1 à 4 chiffres, jamais une expression
  _n=$((10#$_n))
  _a=()
  for ((_i = 0; _i < _n; _i++)); do _v="PULSE_RELAIS_ARG_$_i"; _a+=("${!_v}"); done
  if [ "${#_a[@]}" -gt 0 ]; then set -- "${_a[@]}"; fi # un seul set (pas de reconstruction à chaque tour)
  unset _n _i _v _a
fi
unset "${!PULSE_RELAIS_ARG@}" PULSE_RELAIS_ARGC

RACINE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REF="$RACINE/references"
TPL="$RACINE/templates"
SK="$RACINE/skills"

nom_sur() { # nom_sur <nom> : vrai si le nom reste dans son dossier (ni .., ni chemin absolu, ni lecteur Windows)
  case "$1" in ""|*..*|/*|\\*|[A-Za-z]:*) return 1 ;; esac
  return 0
}

afficher() { # afficher <titre> <chemin>
  if [ -f "$2" ]; then
    printf '\n===== %s =====\n\n' "$1"
    cat "$2"
    printf '\n'
  fi
}

qualite() { # qualite <famille…> [--tout] [--checklists] : précédé de la règle de travail sobre (scripts/charger-regles.js)
  # Un pack déclaré et installé remplace les familles qu'il couvre (ligne « couvre: » de pulse-pile-<id> info).
  local id couvre="" nom=""
  id="$(pack_declare)"
  if [ -n "$id" ] && command -v "pulse-pile-$id" >/dev/null 2>&1; then
    couvre="$(pack_info "$id" couvre)"
    nom="$(pack_info "$id" nom)"
  fi
  PULSE_PACK_COUVRE="$couvre" PULSE_PACK_NOM="$nom" node "$RACINE/scripts/charger-regles.js" qualite "$@"
}

tests() { # tests <morceau…> [--tout] [--checklists] : précédé de la règle de travail sobre (scripts/charger-regles.js)
  node "$RACINE/scripts/charger-regles.js" tests "$@"
}

lexique() { afficher "Modèle : docs/lexique.md" "$TPL/lexique.md"; }

lister_references() { # partagées (references/), puis propres à une skill : <skill>/<fichier> (skills/<skill>/references/)
  (cd "$REF" && find . -type f | sed 's|^\./||' | sort)
  (cd "$SK" && find . -path '*/references/*' -type f | sed 's|^\./\([^/]*\)/references/|\1/|' | sort)
}

lister_modeles() { # partagés (templates/), puis propres à une skill : <skill>/<fichier> (skills/<skill>/assets/)
  ls "$TPL"
  (cd "$SK" && find . -path '*/assets/*' -type f | sed 's|^\./\([^/]*\)/assets/|\1/|' | sort)
}

trouver() { # trouver <references|assets> <nom> : le chemin partagé, sinon celui de la skill (<skill>/<fichier>)
  local partage="$REF"
  [ "$1" = "assets" ] && partage="$TPL"
  if [ -f "$partage/$2" ]; then echo "$partage/$2"
  elif [ -f "$SK/${2%%/*}/$1/${2#*/}" ]; then echo "$SK/${2%%/*}/$1/${2#*/}"
  else return 1
  fi
}

# ---------------------------------------------------------------- Packs de pile
# Un pack de pile est un plugin qui fournit, dans son bin/, un outil pulse-pile-<id> :
#   pulse-pile-<id> info                 id, nom, resume, version (une ligne « clé: valeur » chacun)
#   pulse-pile-<id> contexte <libellé>   consignes du pack : une commande, `piles` ou `code` (un libellé inconnu ne renvoie rien)
# Le projet le déclare dans docs/technical.md : « **Pack de pile Pulse** : <id> ».

pack_declare() {
  [ -f docs/technical.md ] || return 0
  sed -n 's/^\*\*Pack de pile Pulse\*\* *: *\([a-z0-9-]*\).*$/\1/p' docs/technical.md | head -n 1
}

pack_info() { # pack_info <id> <clé>
  "pulse-pile-$1" info 2>/dev/null | sed -n "s/^$2: *//p" | head -n 1
}

piles() {
  local vus=" " dossier outil id
  local IFS=:
  for dossier in $PATH; do
    for outil in "$dossier"/pulse-pile-*; do
      [ -f "$outil" ] && [ -x "$outil" ] || continue
      id="${outil##*/pulse-pile-}"
      case "$id" in *.*) continue ;; esac # relais .ps1 et .cmd du même pack
      case "$vus" in *" $id "*) continue ;; esac
      vus="$vus$id "
      printf -- '- %s : %s – %s (version %s)
' "$id" "$(pack_info "$id" nom)" "$(pack_info "$id" resume)" "$(pack_info "$id" version)"
      "$outil" contexte piles 2>/dev/null | sed 's/^/  /'
    done
  done
  [ "$vus" = " " ] && echo "Aucun pack de pile installé."
  return 0
}

pile() {
  local id; id="$(pack_declare)"
  if [ -z "$id" ]; then echo "Aucun pack de pile déclaré dans docs/technical.md."
  elif command -v "pulse-pile-$id" >/dev/null 2>&1; then echo "Pack de pile déclaré : $id – installé ($(pack_info "$id" nom), version $(pack_info "$id" version))."
  else echo "Pack de pile déclaré : $id – non installé (plugin pulse-$id)."
  fi
}

indication_pack_absent() { # indication_pack_absent <id> : comment installer le pack déclaré mais absent
  local id="$1"
  echo "Le pack de pile « $id » est déclaré mais pas installé : /plugin install pulse-$id@pulseia, puis redémarrer Claude Code."
}

relais_pack() { # relais_pack <sous-commande> [arguments] : exécute pulse-pile-<id déclaré> avec les mêmes arguments
  local id; id="$(pack_declare)"
  if [ -z "$id" ]; then
    echo "Aucun pack de pile déclaré dans docs/technical.md (ligne « **Pack de pile Pulse** : <id> ») : choisir la pile avec /pulse:tech."
    exit 1
  fi
  if ! command -v "pulse-pile-$id" >/dev/null 2>&1; then
    indication_pack_absent "$id"
    exit 1
  fi
  exec "pulse-pile-$id" "$@"
}

contexte_pack() { # contexte_pack <commande>
  local id; id="$(pack_declare)"
  [ -n "$id" ] || return 0
  if command -v "pulse-pile-$id" >/dev/null 2>&1; then
    local sortie; sortie="$("pulse-pile-$id" contexte "$1" 2>/dev/null)"
    [ -n "$sortie" ] || return 0
    printf '
===== Pack de pile : %s =====

' "$(pack_info "$id" nom)"
    printf '%s
' "$sortie"
    printf '
'
  else
    pack_absent "$id"
  fi
}

pack_absent() { # pack_absent <id> : le bloc « non installé » (le pack déclaré manque sur cette machine)
  local id="$1"
  printf '
===== Pack de pile : %s (non installé) =====

' "$id"
  printf 'Le projet déclare le pack de pile « %s » (docs/technical.md), mais il manque sur cette machine. ' "$id"
  printf "Proposer à la personne d'installer son plugin : /plugin install pulse-%s@pulseia, puis de redémarrer Claude Code. " "$id"
  printf 'En attendant, suivre docs/technical.md et la documentation officielle de la pile retenue.
'
}

modules() { # modules <commande> : les modules des règles communes que la commande utilise (T tâches, C relecture, R réalisation)
  case "$1" in
    us|spec|guide|get-help|pr|express|init) afficher "Règles des tâches" "$REF/regles-taches.md" ;;
    security|seo) afficher "Règles de relecture" "$REF/regles-relecture.md" ;;
    ui)
      afficher "Règles des tâches" "$REF/regles-taches.md"
      afficher "Règles de relecture" "$REF/regles-relecture.md" ;;
    status|plan|refine|commit|annuler|fix|auto-fix)
      afficher "Règles des tâches" "$REF/regles-taches.md"
      afficher "Règles de réalisation" "$REF/regles-realisation.md" ;;
    test|review|implement|spirc)
      afficher "Règles des tâches" "$REF/regles-taches.md"
      afficher "Règles de relecture" "$REF/regles-relecture.md"
      afficher "Règles de réalisation" "$REF/regles-realisation.md" ;;
  esac
}

contexte() { # contexte <commande> [--sans-communes | --sans-noyau]
  if ! nom_sur "$1" || [ ! -f "$RACINE/skills/$1/SKILL.md" ]; then
    printf '\n(pulse-aidd : commande inconnue « %s ». Commandes : %s)\n' "$1" "$(ls "$RACINE/skills" | tr '\n' ' ')"
    return 0
  fi
  [ "$2" = "--sans-communes" ] || [ "$2" = "--sans-noyau" ] || afficher "Règles communes Pulse" "$REF/regles-communes.md"
  [ "$2" = "--sans-communes" ] || modules "$1"
  case "$1" in
    init) # dépôt distant, cycle et modèle CLAUDE.md : chargés à l'action qui les cite
      afficher "Bannière" "$SK/init/assets/banniere.txt" ;;
    brainstorm)
      afficher "Penser avant d'écrire" "$REF/raisonnement.md"
      afficher "Règles de la mémoire projet" "$REF/memoire.md"
      afficher "Modèle : docs/brief.md" "$TPL/brief.md"
      afficher "Modèle : aidd_docs/memory/glossary.md" "$TPL/aidd-memory-glossary.md"
      afficher "Modèle : décision (ADR)" "$TPL/aidd-memory-decision.md" ;;
    tech) # la démarche de choix (projet neuf) et l'organisation (étape 6.1, projet neuf sans pack) se chargent à l'étape qui les cite
      afficher "Règles de la mémoire projet" "$REF/memoire.md"
      afficher "Modèle : docs/technical.md" "$SK/tech/assets/technical.md"
      afficher "Modèle : .gitignore" "$TPL/gitignore.template"
      afficher "Modèle : .env.example" "$TPL/env.example.template"
      afficher "Modèle : décision (ADR)" "$TPL/aidd-memory-decision.md" ;;
    memory) # les modèles s'affichent à l'action qui les cite (pulse-aidd modele)
      afficher "Règles de la mémoire projet" "$REF/memoire.md" ;;
    spirc)
      afficher "Examiner une tâche" "$REF/examen.md"
      afficher "Déléguer à l'implementer" "$REF/deleguer.md"
      lexique ;;
    express)
      afficher "Penser avant d'écrire" "$REF/raisonnement.md"
      afficher "Règles de la mémoire projet" "$REF/memoire.md"
      afficher "Modèle : docs/brief.md" "$TPL/brief.md"
      afficher "Modèle : docs/prd.md" "$TPL/prd.md"
      afficher "Les règles des user stories" "$SK/us/references/regles-us.md"
      afficher "Modèle : docs/user-stories.md (référentiel)" "$TPL/user-stories.md"
      afficher "Modèle : aidd_docs/tasks/<epic>/US-XXX-<nom>.md" "$TPL/us.md"
      afficher "Modèle : aidd_docs/memory/glossary.md" "$TPL/aidd-memory-glossary.md"
      afficher "Modèle : travail en cours" "$TPL/in-progress.md" ;;
    prd)
      afficher "Penser avant d'écrire" "$REF/raisonnement.md"
      afficher "Modèle : docs/prd.md" "$TPL/prd.md" ;;
    us)
      afficher "Penser avant d'écrire" "$REF/raisonnement.md"
      afficher "Les règles des user stories" "$SK/us/references/regles-us.md"
      afficher "Modèle : docs/user-stories.md (référentiel)" "$TPL/user-stories.md"
      afficher "Modèle : aidd_docs/tasks/<epic>/US-XXX-<nom>.md" "$TPL/us.md" ;;
    spec) # règles et modèle d'US : chargés avant d'écrire une US créée (pulse-aidd reference us/regles-us.md, pulse-aidd modele us.md)
      afficher "Présentation des écrans" "$SK/spec/references/presentation.md"
      afficher "Scénarios Gherkin" "$REF/tests/gherkin.md"
      afficher "Modèle : aidd_docs/tasks/<epic>/SPEC-US-XXX-<nom>.md" "$SK/spec/assets/spec.md" ;;
    plan)
      afficher "Checklist sécurité" "$REF/checklist-securite.md"
      afficher "Stratégie de tests" "$REF/tests/strategie.md"
      afficher "Motifs d'écrans" "$SK/ui/references/motifs.md"
      afficher "Modèle : aidd_docs/tasks/<epic>/PLAN-SPEC-US-XXX-<nom>.md" "$TPL/plan.md" ;;
    implement)
      afficher "Tests automatiques" "$REF/tests-automatiques.md"
      afficher "Travailler dans un worktree" "$REF/worktree.md"
      afficher "Déléguer à l'implementer" "$REF/deleguer.md"
      lexique ;;
    fix) lexique ;;
    review) afficher "Examiner une tâche" "$REF/examen.md" ;;
    commit)
      afficher "Conventions Git" "$REF/git.md"
      afficher "Le dépôt distant et l'envoi du travail" "$REF/depot-distant.md"
      afficher "Modèle : .gitignore" "$TPL/gitignore.template" ;;
    pr)
      afficher "Conventions Git" "$REF/git.md"
      afficher "Modèle : description de demande de fusion" "$SK/pr/assets/pull-request.md" ;;
    annuler) ;; # ni conventions Git ni dépôt distant : les gestes sont dans pulse-aidd annuler, l'envoi se lit à l'étape 6
    get-help) afficher "Modèle : demande d'aide" "$SK/get-help/assets/demande-aide.md" ;;
    cicd)
      afficher "Le dépôt distant et l'envoi du travail" "$REF/depot-distant.md"
      afficher "Exemple de CI à adapter" "$TPL/ci-verifications.yml.template"
      afficher "Conventions Git" "$REF/git.md" ;;
    deploy)
      afficher "Le dépôt distant et l'envoi du travail" "$REF/depot-distant.md"
      afficher "Garder la valeur d'un secret hors de la conversation" "$REF/secrets/sans-conversation.md"
      afficher "Exemple de CI à adapter" "$TPL/ci-verifications.yml.template" ;;
    security) afficher "Modèle : docs/securite.md" "$SK/security/assets/securite.md" ;; # la checklist : chargée par l'auditeur
    secrets)
      afficher "Garder la valeur d'un secret hors de la conversation" "$REF/secrets/sans-conversation.md"
      afficher "Réagir à une fuite de clé" "$SK/secrets/references/fuite.md"
      afficher "Modèle : docs/secrets.md" "$SK/secrets/assets/secrets.md"
      afficher "Modèle : journal d'incident" "$SK/secrets/assets/incident.md"
      lexique ;;
    refine)
      afficher "Règles du plan (/pulse:plan)" "$RACINE/skills/plan/SKILL.md"
      afficher "Modèle : aidd_docs/tasks/<epic>/PLAN-SPEC-US-XXX-<nom>.md" "$TPL/plan.md" ;;
    ui)
      afficher "Règles de la mémoire projet" "$REF/memoire.md"
      afficher "Registres d'interface" "$SK/ui/references/registres.md"
      afficher "Règles d'interface" "$SK/ui/references/regles-ui.md"
      afficher "Anti-patterns d'interface" "$SK/ui/references/anti-patterns.md"
      afficher "Motifs d'écrans" "$SK/ui/references/motifs.md"
      afficher "Modèle : docs/design.md" "$SK/ui/assets/design.md"
      afficher "Modèle : note de variante" "$SK/ui/assets/maquette-note.md"
      afficher "Modèle : rapport d'audit d'interface" "$SK/ui/assets/revue-ui.md" ;;
    rediger)
      afficher "Rédiger les textes des pages" "$SK/rediger/references/regles.md"
      afficher "Modèle : docs/voix.md" "$SK/rediger/assets/voix.md"
      afficher "Modèle : docs/textes/<page>.md" "$SK/rediger/assets/texte-page.md"
      lexique ;;
    seo)
      afficher "Référencement : les règles" "$SK/seo/references/regles.md"
      afficher "Référencement : assistants IA" "$SK/seo/references/ia.md"
      afficher "Modèle : docs/seo.md" "$SK/seo/assets/seo.md"
      afficher "Modèle : rapport d'audit de référencement" "$SK/seo/assets/seo-audit.md"
      lexique ;;
    perf)
      afficher "La vitesse vécue par les visiteurs" "$SK/perf/references/performance.md"
      afficher "Modèle : docs/performance.md" "$SK/perf/assets/performance.md"
      lexique ;;
    search-console)
      afficher "Search Console : relier, lire, suivre" "$SK/search-console/references/search-console.md"
      afficher "Modèle : docs/referencement/search-console-<date>.md" "$SK/search-console/assets/rapport-search-console.md"
      afficher "Modèle : travail en cours" "$TPL/in-progress.md"
      lexique ;;
    learn)
      afficher "Pédagogie du professeur" "$SK/learn/references/pedagogie.md"
      afficher "Modèle : docs/apprentissage.md" "$SK/learn/assets/apprentissage.md"
      lexique ;;
    explain) lexique ;;
    test) lexique ;;
    guide)
      afficher "Les fichiers du projet" "$REF/fichiers-projet.md"
      afficher "Le cycle Pulse" "$REF/cycle.md" ;;
    status)
      afficher "Le cycle Pulse" "$REF/cycle.md" ;;
    auto-fix) ;;
    *) ;; # commande du cœur sans référence propre : les règles communes suffisent
  esac
  # review, spirc, auto-fix, implement : les agents qui relisent ou codent chargent eux-mêmes les consignes du pack (pulse-aidd pile contexte <commande>) ; la conversation principale orchestre.
  # Pack déclaré mais absent : le bloc « non installé » reste affiché, la conversation propose de l'installer.
  case "$1" in review|spirc|auto-fix|implement) command -v "pulse-pile-$(pack_declare)" >/dev/null 2>&1 || { [ -z "$(pack_declare)" ] || pack_absent "$(pack_declare)"; } ;; *) contexte_pack "$1" ;; esac
}

case "$1" in
  contexte) contexte "$2"; exit 0 ;;
  etape)
    if ! nom_sur "$2" || [ ! -f "$RACINE/skills/$2/SKILL.md" ]; then echo "Commande inconnue : $2. Commandes : $(ls "$RACINE/skills" | tr '\n' ' ')"; exit 0; fi
    case "$3" in
      --sans-communes) echo "(Règles communes, noyau et modules : déjà chargés par la commande en cours ; appliquer seulement le Processus ci-dessous.)" ;;
      --sans-noyau) echo "(Règles communes (noyau) : déjà chargées par la commande en cours ; les modules de cette étape suivent ; appliquer le Processus ci-dessous.)" ;;
    esac
    printf '
===== Instructions de l'"'"'étape /pulse:%s =====

' "$2"
    awk 'n<2&&/^---$/{n++;next} n>=2' "$RACINE/skills/$2/SKILL.md" | awk '/^## (Exemples|Références de la commande)/{s=1;next} /^## /{s=0} !s'
    printf '
'
    contexte "$2" "$3"; exit 0 ;;
  modele)
    if nom_sur "$2" && chemin="$(trouver assets "$2")"; then cat "$chemin"; else echo "Modèle introuvable : $2. Disponibles :"; lister_modeles; exit 1; fi ;;
  agent)
    if nom_sur "$2" && [ -f "$RACINE/agents/$2.md" ]; then cat "$RACINE/agents/$2.md"; else echo "Agent introuvable : $2 (reviewer, security-auditor, explorer, implementer, verifier, fixer, test-writer, test-runner, designer, ui-critic, redacteur, memory-compactor)"; exit 1; fi ;;
  qualite) shift; qualite "$@"; exit $? ;;
  tests) shift; tests "$@"; exit $? ;;
  reference)
    case "$2" in
      ""|*..*) echo "Indiquez un chemin dans references/, par exemple qualite/code-concepts.md. Disponibles :"; lister_references; exit 1 ;;
    esac
    if nom_sur "$2" && chemin="$(trouver references "$2")"; then cat "$chemin"; else echo "Référence introuvable : $2. Disponibles :"; lister_references; exit 1; fi ;;
  nouveau)
    shift; exec node "$RACINE/skills/init/scripts/nouveau-projet.js" "$@" ;;
  guide)
    exec node "$RACINE/scripts/guide.js" ;;
  comparer)
    if [ -z "$2" ]; then echo "Usage : pulse-aidd comparer <dossier de variantes>"; exit 1; fi
    exec node "$RACINE/skills/ui/scripts/comparer.js" "$2" ;;
  memoire)
    exec node "$RACINE/scripts/memoire.js" --rapport ;;
  realisation)
    shift
    node "$RACINE/scripts/realisation.js" "$@"; code=$?
    # Devant vous (marqueur lancé avec --devant) : l'étape realisation affiche aussitôt le contexte implement du pack déclaré
    # (sa fiche), ou le bloc « non installé » : la conversation le lit avant le premier fichier écrit. Les tests, eux,
    # s'écrivent par le test-writer (ou en suivant ses consignes), qui charge lui-même le contexte des tests du pack.
    if [ "$code" -eq 0 ] && [ "${1:-}" = etape ] && [ -n "${2:-}" ] && [ "${3:-}" = realisation ] && [ -n "$(pack_declare)" ]; then
      if node "$RACINE/scripts/realisation.js" 2>/dev/null | grep -qx 'devant: true'; then contexte_pack implement; fi
    fi
    exit "$code" ;;
  attente)
    shift; exec node "$RACINE/skills/spirc/scripts/attente.js" "$@" ;;
  sessions)
    shift; exec node "$RACINE/scripts/sessions.js" "$@" ;;
  annuler)
    shift; exec node "$RACINE/skills/annuler/scripts/annuler.js" "$@" ;;
  verifier)
    exec node "$TPL/verifier.js" ;;
  preuve)
    shift; exec node "$RACINE/scripts/preuve.js" "$@" ;;
  scenarios)
    exec node "$TPL/verifier.js" --scenarios ;;
  autorisations)
    shift; exec node "$RACINE/scripts/autorisations.js" "$@" ;;
  copies)
    shift; exec node "$RACINE/scripts/copies.js" "$@" ;;
  ligne-etat)
    shift; exec node "$RACINE/scripts/ligne-etat.js" "$@" ;;
  captures)
    shift; exec node "$RACINE/scripts/captures.js" "$@" ;;
  bilan)
    exec node "$RACINE/scripts/bilan.js" ;;
  verifier-spec)
    shift; exec node "$RACINE/scripts/verifier-spec.js" "$@" ;;
  verifier-plan)
    shift; exec node "$RACINE/scripts/verifier-plan.js" "$@" ;;
  piles) piles; exit 0 ;;
  pile)
    shift
    [ $# -eq 0 ] && { pile; exit 0; }
    # contexte : un projet sans pack n'a rien à charger (sortie vide, code 0) ; le pack déclaré mais absent est signalé.
    if [ "$1" = contexte ]; then
      [ -n "$(pack_declare)" ] || exit 0
      command -v "pulse-pile-$(pack_declare)" >/dev/null 2>&1 || { indication_pack_absent "$(pack_declare)"; exit 0; }
    fi
    relais_pack "$@" ;;
  sonder)
    shift; exec node "$RACINE/scripts/sonder.js" "$@" ;;
  secrets)
    shift; exec node "$RACINE/skills/secrets/scripts/secrets.js" "$@" ;;
  textes)
    shift; exec node "$RACINE/skills/rediger/scripts/textes.js" "$@" ;;
  contraste)
    shift; exec node "$RACINE/skills/ui/scripts/contraste.js" "$@" ;;
  identite)
    shift; exec node "$RACINE/skills/ui/scripts/identite.js" "$@" ;;
  maquettes)
    shift; exec node "$RACINE/skills/ui/scripts/maquettes.js" "$@" ;;
  seo)
    # Git Bash (Windows) transforme « /compte » en « C:/Program Files/Git/compte » avant de lancer Node.
    # Les chemins passés (--chemins /compte) restent tels quels ; le script est donné sous sa forme Windows.
    shift; script="$RACINE/skills/seo/scripts/seo.js"
    command -v cygpath >/dev/null 2>&1 && script="$(cygpath -m "$script")"
    MSYS_NO_PATHCONV=1 exec node "$script" "$@" ;;
  perf)
    shift; exec node "$RACINE/skills/perf/scripts/perf.js" "$@" ;;
  search-console)
    shift; exec node "$RACINE/skills/search-console/scripts/search-console.js" "$@" ;;
  etat)
    shift; exec node "$RACINE/scripts/etat.js" "$@" ;;
  revue)
    shift; exec node "$RACINE/scripts/etat.js" --revue "$@" ;;
  travail-fini)
    dossier="${2:-.}"
    case "/$dossier/" in
      */../*) echo "Le dossier ne doit pas contenir « .. » : donnez le dossier du projet ou de son worktree (ex. .claude/worktrees/us-001-creer-tache)."; exit 1 ;;
    esac
    [ -d "$dossier" ] || { echo "Dossier introuvable : $dossier"; exit 1; }
    rm -f "$dossier/aidd_docs/tasks/in-progress.md"
    echo "Travail en cours effacé : aucune décision en attente." ;;
  installer-ci)
    mkdir -p scripts
    etat="$(node "$RACINE/scripts/copies.js" | grep "· scripts/verifier.js$" | cut -d" " -f2)"
    if [ -f scripts/verifier.js ] && [ "$etat" = "adaptee" ] && [ "$2" != "--forcer" ]; then
      echo "scripts/verifier.js existe déjà et diffère du modèle de Pulse : rien n'est remplacé. Comparez avec « pulse-aidd modele verifier.js », puis relancez « pulse-aidd installer-ci --forcer » pour le remplacer."
      exit 1
    fi
    node "$RACINE/scripts/copies.js" --copier verifier scripts/verifier.js
    cp "$TPL/ci-verifications.yml.template" scripts/ci-verifications.exemple.yml
    echo "Installé : scripts/verifier.js (contrôle des secrets) et scripts/ci-verifications.exemple.yml (exemple de CI à adapter à l'outil retenu)" ;;
  installer-hook)
    racine="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "Pas de dépôt Git ici : lancez d'abord /pulse:init."; exit 1; }
    dossier_hooks="$(git config core.hooksPath)"
    if [ -n "$dossier_hooks" ]; then
      echo "Git range les contrôles avant commit dans $dossier_hooks (Husky, ou un réglage de Git valable pour tous vos projets) : Pulse n'y écrit pas. Ajoutez-y la ligne « node scripts/verifier.js --index »."
      exit 1
    fi
    crochet="$(git rev-parse --git-path hooks/pre-commit)"
    if [ -f "$crochet" ] && ! grep -q "pulse-aidd: contrôle des secrets" "$crochet"; then
      echo "Un contrôle avant commit existe déjà ($crochet) : rien n'est remplacé. Ajoutez-y la ligne « node scripts/verifier.js --index »."
      exit 1
    fi
    if [ -f "$racine/scripts/verifier.js" ] && ! grep -q -e "--index" "$racine/scripts/verifier.js"; then
      echo "scripts/verifier.js est une ancienne version, sans contrôle avant commit : mettez-le à jour d'abord : comparez-le avec « pulse-aidd modele verifier.js », puis lancez « pulse-aidd installer-ci --forcer », puis relancez pulse-aidd installer-hook."
      exit 1
    fi
    [ -f "$racine/scripts/verifier.js" ] || node "$RACINE/scripts/copies.js" --copier verifier "$racine/scripts/verifier.js"
    # Copie de secours, partagée par les worktrees (chemin absolu calculé par cd et pwd : --path-format demande Git 2.31) : un worktree créé avant le premier commit de scripts/verifier.js reste contrôlé.
    secours="$(cd "$(git rev-parse --git-common-dir)" && pwd)/pulse/verifier.js"
    mkdir -p "$(dirname "$secours")" "$(dirname "$crochet")"
    node "$RACINE/scripts/copies.js" --copier verifier "$secours"
    cat > "$crochet" <<'CROCHET'
#!/bin/sh
# pulse-aidd: contrôle des secrets avant chaque commit (installé par /pulse:cicd ou /pulse:init).
# scripts/verifier.js du projet, sinon la copie gardée par Git ; sans l'un ni l'autre, le commit est refusé.
command -v node >/dev/null 2>&1 || { echo "❌ Commit annulé : Node.js est introuvable, le contrôle des secrets ne peut pas tourner. Installez Node.js 22.19 ou plus, puis relancez le commit." >&2; exit 1; }
[ -f scripts/verifier.js ] && exec node scripts/verifier.js --index
secours="$(cd "$(git rev-parse --git-common-dir)" && pwd)/pulse/verifier.js"
[ -f "$secours" ] && exec node "$secours" --index
{
  echo "❌ Commit annulé : le contrôle des secrets est introuvable."
  echo "   Avant chaque commit, Pulse vérifie qu'aucune clé secrète (mot de passe, clé d'API) ne part avec votre travail."
  echo "   Ce contrôle vit dans scripts/verifier.js, avec une copie de secours gardée par Git : les deux manquent dans ce projet."
  echo "   Vos modifications restent en place, prêtes à être enregistrées."
  echo "   Pour réparer : dans Claude Code, demandez /pulse:cicd (ou lancez pulse-aidd installer-hook dans le dossier du projet), puis refaites le commit."
} >&2
exit 1
CROCHET
    chmod +x "$crochet"
    echo "Installé : contrôle des secrets avant chaque commit, y compris ceux faits hors de Claude Code ($crochet)." ;;
  *)
    sed -n '2,/^$/p' "${BASH_SOURCE[0]}" | sed -n 's/^# \{0,1\}//p' ;;
esac
