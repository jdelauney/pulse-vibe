{
  "description": "Pulse – garde-fou anti-secrets (bloque l'écriture d'une clé secrète dans le code et l'envoi de fichiers .env ou de clés dans Git), synchronisation de la mémoire projet à l'ouverture de chaque session, et régénération du guide de réalisation à chaque modification d'un plan de aidd_docs/tasks/.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/memoire.js"],
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guide.js", "--hook"],
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/garde-secrets.js"],
            "timeout": 20,
            "statusMessage": "Pulse vérifie l'absence de secrets…"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/garde-secrets.js"],
            "timeout": 20,
            "statusMessage": "Pulse vérifie l'absence de secrets…"
          }
        ]
      }
    ]
  }
}
